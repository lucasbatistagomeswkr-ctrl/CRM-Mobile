@inherits LayoutComponentBase
@using CrmMobile.Services
@inject AuthService Auth
@implements IDisposable

@if (!Auth.Logado)
{
    <Login />
}
else
{
    <div class="app-shell">
        <header class="app-top">
            <h1 class="app-logo">Stoque.me</h1>
            <div class="app-user">
                <span>@Auth.Usuario?.Nome</span>
                <button class="btn btn-sm btn-outline-light" @onclick="Auth.Sair">Sair</button>
            </div>
        </header>

        <main class="app-content">
            @Body
        </main>

        <NavMenu />
    </div>
}

@code {
    protected override void OnInitialized() => Auth.Mudou += Atualizar;

    void Atualizar() => InvokeAsync(StateHasChanged);

    public void Dispose() => Auth.Mudou -= Atualizar;
}